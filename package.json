{
  "name": "liste-app",
  "private": true,
  "version": "1.0.5",
  "repository": {
    "type": "git",
    "url": "https://github.com/glouglou49/liste.git"
  },
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "electron:build": "vite build && electron-builder",
    "electron:release": "vite build && electron-builder --publish always",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-electron",
    "lint": "eslint src electron --ext .ts,.tsx && tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "electron-updater": "^6.8.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "date-fns": "^4.1.0",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "electron-rebuild": "^3.2.9",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7",
    "zustand": "^5.0.12"
  },
  "build": {
    "appId": "com.glouglou49.liste-bom",
    "productName": "Liste BOM",
    "compression": "maximum",
    "files": [
      "dist/**",
      "dist-electron/**",
      "!**/*.ts",
      "!**/*.tsx",
      "!db/**",
      "!read_db*",
      "!get_schema*",
      "!*.example",
      "!src/**",
      "!electron/**/*.ts"
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      "github"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "differentialPackage": false
    }
  }
}